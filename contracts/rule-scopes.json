  "note": "Which generated rule file holds each CONTRACTS.md clause (CONTRACTS.md 5.5). A clause has exactly one home, chosen as the broadest scope it matters in. Every clause must be listed. Changing this file is an audited act (9.4).",
  "groups": {
    "core": {
      "paths": null,
      "summary": "Always loaded: how to read, conduct, process, and the clause index."
    },
    "build": {
      "paths": [
        "/app/**",
        "/components/**"
      ],
      "summary": "Tokens, type, copy, icons, Figma, components in use, behaviour patterns."
    },
    "components": {
      "paths": [
        "/components/**"
      ],
      "summary": "Creating or changing a component: override, duplicates, ingest hygiene, ambient leaks."
    },
    "shell": {
      "paths": [
        "app/pages/**",
        "lib/create-menu.ts",
        "lib/registered-user-nav.ts",
        "config/role-access.config.ts"
      ],
      "summary": "The persona shell and page patterns: header, rail, columns, forms, lists, record pages, floating panels."
    },
    "prototyping": {
      "paths": [
        "app/pages/**",
        "app/proto/**",
        "app/_prototype-tools/**",
        "lib/layers.ts"
      ],
      "summary": "Prototype tools bar and competing layout options: what previews on a screen, and how options are presented and retired."
    },
    "docs": {
      "paths": [
        "app/*docs*/**",
        "lib/nav.ts",
        "config/design-system.config.ts",
        "/README.md"
      ],
      "summary": "Doc pages, generated /test-* screens, navigation order."
    },
    "governance": {
      "paths": [
        "/CONTRACTS.md",
        "/contracts/**",
        "/scripts/**",
        "/.github/**",
        ".claude/settings.json"
      ],
      "summary": "Changing the contracts, overrides, audit and the checks themselves."
    }
  },
